{
  "name": "jp-fiscal-dates",
  "version": "0.2.0",
  "description": "Date utilities for Japanese small-business accounting: month ranges, JST today, month arithmetic with end-of-month clamping, national holidays, and payroll periods driven by a closing date.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "keywords": [
    "japan",
    "japanese",
    "date",
    "holiday",
    "payroll",
    "accounting",
    "fiscal",
    "jst",
    "typescript"
  ],
  "author": "Hallow-orca",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hallow-orca/jp-fiscal-dates.git"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.4"
  }
}
